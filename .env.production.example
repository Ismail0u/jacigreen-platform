# JACIGREEN production environment example
# Copy this file to .env.production and fill the real values.

# Backend
ENVIRONMENT=production
SECRET_KEY=replace_with_strong_secret_min_32_characters
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/jacigreen
REDIS_URL=redis://host:6379/0
ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-app.vercel.app
ALLOWED_HOSTS=your-backend.railway.app,localhost,127.0.0.1
DEBUG=false
AI_MODEL_PATH=ai/models/jacinthe_v1.onnx
AI_CONFIDENCE_THRESHOLD=0.45
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_or_anon_key
SUPABASE_STORAGE_BUCKET=photos

# Frontend
VITE_API_URL=https://your-backend.railway.app

# Optional
ROBOFLOW_API_KEY=
